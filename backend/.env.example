# Admin password gating the dashboard and conversion routes.
ADMIN_PASSWORD=change-me

# Comma-separated origins allowed to call this API cross-origin.
ALLOWED_ORIGIN=https://mockup-dibiaa.vercel.app,http://localhost:5500

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=15

# Abandon a VTracer trace after this long and answer 504.
VTRACER_TIMEOUT_MS=30000

# Longest edge, in pixels, an image is downscaled to before tracing. Tracing cost
# and SVG size both grow with pixel count: 2000px traces a photo in about 0.4s,
# while tracing 4000px natively took 23.7s and produced a 74MB SVG that no editor
# can usefully open. Higher values give logos crisper edges.
VTRACER_MAX_EDGE=2000
