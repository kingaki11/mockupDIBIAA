# Admin password gating the dashboard and conversion routes.
ADMIN_PASSWORD=change-me

# ── Storage ──
# Leave DB_HOST unset to keep the catalog and images as files (catalog.json plus
# images) under DATA_DIR — or the Railway volume when one is mounted.
# DATA_DIR=/path/to/persistent/folder
#
# Set DB_HOST to store everything in MySQL instead (e.g. a Hostinger database).
# The tables are created on first start. To copy an existing deployment's data
# in, POST {"source":"https://old-deployment"} to /admin/import-from.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# When the backend also serves the website (whole-repo deploy), the page calls
# this same server. Set this only to point the page at a different API instead.
# PUBLIC_API_BASE=

# Comma-separated origins allowed to call this API cross-origin.
ALLOWED_ORIGIN=https://mockup-dibiaa.vercel.app,http://localhost:5500

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=15

# Abandon a VTracer trace after this long and answer 504.
VTRACER_TIMEOUT_MS=30000

# Longest edge, in pixels, an image is downscaled to before tracing. Tracing cost
# and SVG size both grow with pixel count: 2000px traces a photo in about 0.4s,
# while tracing 4000px natively took 23.7s and produced a 74MB SVG that no editor
# can usefully open. Higher values give logos crisper edges.
VTRACER_MAX_EDGE=2000

# Optional AI clean-up pass before tracing (OpenAI image edits). Leave unset to
# disable the feature entirely — the checkbox then hides itself in the UI.
# gpt-image-2.5-sunburst reproduces artwork faithfully, including non-Latin
# scripts, and natively supports the transparent background this path needs —
# the preview of that on gpt-image-2 is withdrawn on 30 September 2026.
# gpt-image-2.5-flare is the same price and about twice as fast if you would
# rather trade a little edit precision for speed. quality=low measured
# indistinguishable from medium on every logo tried; roughly $0.014-0.021 a
# conversion.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=low
OPENAI_TIMEOUT_MS=120000
